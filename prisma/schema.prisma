generator client {
  provider = "prisma-client-js"
}

datasource db {
  relationMode = "prisma"
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/**
 * =========================================================
 * ENUMS
 * =========================================================
 */

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProductType {
  SINGLE
  COMBO
}

enum SEOIndexStatus {
  INDEX
  NOINDEX
}

enum SEORobotsFollow {
  FOLLOW
  NOFOLLOW
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CampaignType {
  DISCOUNT
  FLASH_SALE
  EMAIL
  WHATSAPP
  POPUP
  BANNER
  GENERAL
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  CATEGORY_VIEW
  SEARCH
  ADD_TO_CART
  REMOVE_FROM_CART
  WISHLIST_ADD
  WISHLIST_REMOVE
  CHECKOUT_START
  PURCHASE
  LOGIN
  SIGNUP
}

enum AIContentType {
  PRODUCT_DESCRIPTION
  META_TITLE
  META_DESCRIPTION
  ALT_TEXT
  CATEGORY_DESCRIPTION
  BRAND_DESCRIPTION
  BLOG
  FAQ
  SOCIAL_POST
  AD_COPY
  EMAIL
  WHATSAPP
  OTHER
}

enum AIInsightType {
  SALES
  PRODUCT
  CUSTOMER
  INVENTORY
  SEO
  MARKETING
  GENERAL
}

enum AIActionStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

enum RedirectType {
  PERMANENT
  TEMPORARY
}

/**
 * =========================================================
 * USER
 * =========================================================
 */

model User {
  id String @id @default(cuid())

  name         String
  email        String  @unique
  phone        String?
  passwordHash String?

  role Role @default(USER)
  adminAuthRole String? @db.VarChar(32)

  image   String?
  address Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders   Order[]
  cart     Cart?
  wishlist Wishlist?
  reviews  Review[]

  activities AdminActivity[]

  analyticsEvents AnalyticsEvent[]

  inventoryMovements InventoryMovement[]

  adminRoles AdminUserRole[]
  authSessions AdminAuthSession[]
  passwordResetTokens AdminPasswordResetToken[]
  inviteTokens AdminInviteToken[]
  securityEvents SecurityEvent[]
  adminActive   Boolean   @default(false)

  @@map("user")
}

model AdminAuthSession {
  id String @id @default(cuid())
  userId String @db.VarChar(191)
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  rememberMe Boolean @default(false)
  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(512)
  lastUsedAt DateTime @default(now())
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([userId, revokedAt])
  @@index([expiresAt])

  @@map("adminauthsession")
}

model AdminPasswordResetToken {
  id String @id @default(cuid())
  userId String @db.VarChar(191)
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([userId, usedAt])
  @@index([expiresAt])

  @@map("adminpasswordresettoken")
}

model AdminInviteToken {
  id        String    @id
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expiresAt])
  @@index([userId, usedAt, revokedAt])
  @@map("admininvitetoken")
}

model AdminLoginThrottle {
  id String @id @default(cuid())
  key String @unique @db.VarChar(191)
  failures Int @default(0)
  lockedUntil DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("adminloginthrottle")
}

model SecurityEvent {
  id String @id @default(cuid())
  userId String? @db.VarChar(191)
  eventType String @db.VarChar(64)
  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(512)
  metadata Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([eventType, createdAt])
  @@index([userId, createdAt])

  @@map("securityevent")
}

model AdminPermission {
  id String @id @default(cuid())

  key         String  @unique
  label       String?
  module      String?
  description String?

  createdAt DateTime @default(now())

  rolePermissions AdminRolePermission[]

  @@map("adminpermission")
}

model AdminRole {
  id String @id @default(cuid())

  name        String  @unique
  key         String  @unique
  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions AdminRolePermission[]
  userRoles   AdminUserRole[]

  @@map("adminrole")
}

model AdminRolePermission {
  id String @id @default(cuid())

  adminRoleId String @db.VarChar(64)
  permissionId String @db.VarChar(64)

  adminRole AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([adminRoleId, permissionId])

  @@map("adminrolepermission")
}

model AdminUserRole {
  id String @id @default(cuid())

  userId String @db.VarChar(64)
  adminRoleId String @db.VarChar(64)
  isActive Boolean @default(true)
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([userId, adminRoleId])

  @@map("adminuserrole")
}

/**
 * =========================================================
 * CATEGORY
 * =========================================================
 */

model Category {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?
  image       String?

  active Boolean @default(true)

  parentId String?

  parent Category? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryTree")

  homepageSections HomepageSection[]

  products Product[]

  attributes CategoryAttribute[]

  seo CategorySEO?

  analyticsEvents AnalyticsEvent[]

  createdAt DateTime @default(now())

  @@map("category")
}

/**
 * =========================================================
 * BRAND
 * =========================================================
 */

model Brand {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?

  logo  String?
  image String?

  website String?

  active   Boolean @default(true)
  featured Boolean @default(false)

  products Product[]

  seo BrandSEO?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand")
}

/**
 * =========================================================
 * PRODUCT
 * =========================================================
 */

model Product {
  id String @id @default(cuid())

  name String
  slug String @unique
  sku  String @unique

  shortDescription String?
  description      String? @db.Text

  regularPrice Decimal  @db.Decimal(10, 2)
  salePrice    Decimal? @db.Decimal(10, 2)
  costPrice    Decimal? @db.Decimal(10, 2)

  stock    Int @default(0)
  lowStock Int @default(5)

  /**
   * Existing brand field রাখা হয়েছে
   * যাতে পুরোনো data নষ্ট না হয়।
   */
  brand String?

  /**
   * New proper Brand relation
   */
  brandId String?

  brandRelation Brand? @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productType ProductType @default(SINGLE)

  featured Boolean @default(false)
  active   Boolean @default(true)

  categoryId String

  category Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  images ProductImage[]

  variants ProductVariant[]

  attributeValues ProductAttributeValue[]

  orderItems OrderItem[]

  reviews Review[]

  cartItems CartItem[]

  wishlistItems WishlistItem[]

  seo ProductSEO?

  analyticsEvents AnalyticsEvent[]

  inventoryMovements InventoryMovement[]

  comboItems ProductComboItem[] @relation("ComboProduct")

  includedInCombos ProductComboItem[] @relation("IncludedProduct")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, active])
  @@index([brandId, active])

  @@map("product")
}

model ProductComboItem {
  id String @id @default(cuid())

  comboProductId String
  includedProductId String

  quantity Int @default(1)

  comboProduct Product @relation("ComboProduct", fields: [comboProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  includedProduct Product @relation("IncludedProduct", fields: [includedProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([comboProductId(length: 64), includedProductId(length: 64)])
  @@index([comboProductId])
  @@index([includedProductId])

  @@map("productcomboitem")
}

/**
 * =========================================================
 * PRODUCT IMAGE
 * =========================================================
 */

model ProductImage {
  id String @id @default(cuid())

  url String
  alt String?

  sortOrder Int @default(0)

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([productId, sortOrder])
  @@map("productimage")
}

/**
 * =========================================================
 * PRODUCT VARIANT
 * =========================================================
 */

model ProductVariant {
  id String @id @default(cuid())

  size  String?
  color String?

  price Decimal? @db.Decimal(10, 2)

  stock Int @default(0)

  sku String @unique

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attributeValues ProductVariantAttributeValue[]

  cartItems CartItem[]

  orderItems OrderItem[]

  @@index([productId])

  @@map("productvariant")
}

/**
 * =========================================================
 * GLOBAL PRODUCT ATTRIBUTES
 * =========================================================
 */

model Attribute {
  id String @id @default(cuid())

  name String
  slug String @unique
  kind String @default("TEXT")
  active Boolean @default(true)
  sortOrder Int @default(0)

  values AttributeValue[]
  categories CategoryAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attribute")
}

model AttributeValue {
  id String @id @default(cuid())

  attributeId String
  name String
  slug String
  hexValue String?
  active Boolean @default(true)
  sortOrder Int @default(0)

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products ProductAttributeValue[]
  variants ProductVariantAttributeValue[]

  @@unique([attributeId(length: 64), slug(length: 64)])
  @@index([attributeId, active])

  @@map("attributevalue")
}

model CategoryAttribute {
  categoryId String
  attributeId String

  category Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([categoryId(length: 64), attributeId(length: 64)])
  @@index([attributeId])

  @@map("categoryattribute")
}

model ProductAttributeValue {
  productId String
  attributeValueId String

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([productId(length: 64), attributeValueId(length: 64)])
  @@index([attributeValueId])

  @@map("productattributevalue")
}

model ProductVariantAttributeValue {
  variantId String
  attributeValueId String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([variantId(length: 64), attributeValueId(length: 64)])
  @@index([attributeValueId])

  @@map("productvariantattributevalue")
}

/**
 * =========================================================
 * CART
 * =========================================================
 */

model Cart {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items CartItem[]

  updatedAt DateTime @updatedAt

  @@map("cart")
}

/**
 * =========================================================
 * CART ITEM
 * =========================================================
 */

model CartItem {
  id String @id @default(cuid())

  quantity Int @default(1)

  attributeValueIds Json?
  attributeSelectionKey String @default("")

  cartId String

  cart Cart @relation(fields: [cartId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variantId String?

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([cartId(length: 32), productId(length: 32), variantId(length: 32), attributeSelectionKey(length: 128)])

  @@map("cartitem")
}

/**
 * =========================================================
 * WISHLIST
 * =========================================================
 */

model Wishlist {
  id String @id @default(cuid())

  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items WishlistItem[]

  @@map("wishlist")
}

/**
 * =========================================================
 * WISHLIST ITEM
 * =========================================================
 */

model WishlistItem {
  id String @id @default(cuid())

  wishlistId String

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([wishlistId(length: 64), productId(length: 64)])

  @@map("wishlistitem")
}

/**
 * =========================================================
 * ORDER
 * =========================================================
 */

model Order {
  id String @id @default(cuid())

  orderNumber String @unique

  userId String?

  freeDelivery         Boolean             @default(false)
  deliveryDivision     String?
  deliveryDistrict     String?
  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerName  String
  customerEmail String?
  customerPhone String

  shippingAddress Json
  billingAddress  Json?

  subtotal Decimal @db.Decimal(10, 2)

  discount Decimal @default(0) @db.Decimal(10, 2)

  shippingCharge Decimal @default(0) @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  paymentMethod String

  paymentTransactionId String?

  orderNote String? @db.Text

  paymentStatus PaymentStatus @default(PENDING)

  status OrderStatus @default(PENDING)

  items OrderItem[]

  createdAt DateTime @default(now())

  @@map("order")
}

/**
 * =========================================================
 * ORDER ITEM
 * =========================================================
 */

model OrderItem {
  id String @id @default(cuid())

  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)

  productName String

  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variantId String?

  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variantLabel String?

  attributeValueIds Json?

  @@index([productId])

  @@map("orderitem")
}

/**
 * =========================================================
 * COUPON
 * =========================================================
 */

model Coupon {
  id String @id @default(cuid())

  code String @unique

  type DiscountType

  value Decimal @db.Decimal(10, 2)

  minimumOrder Decimal? @db.Decimal(10, 2)

  expiresAt DateTime?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupon")
}

/**
 * =========================================================
 * REVIEW
 * =========================================================
 */

model Review {
  id String @id @default(cuid())

  rating Int

  comment String?

  approved Boolean @default(false)

  verifiedPurchase Boolean @default(false)

  userId String

  productId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([userId, productId])
  @@index([productId, approved, createdAt])

  @@map("review")
}

/**
 * =========================================================
 * BANNER
 * =========================================================
 */

model Banner {
  id String @id @default(cuid())

  title String
  subtitle String?

  image String?
  desktopImage String?
  mobileImage String?

  link String?
  buttonText String?

  startAt DateTime?
  endAt DateTime?

  active Boolean @default(true)
  sortOrder Int @default(0)

  @@map("banner")
}

/**
 * =========================================================
 * HOME RIGHT PROMOTIONAL BANNER
 * =========================================================
 */

model HomeRightBanner {
  id        String   @id @default(cuid())
  image     String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("homerightbanner")
}

/**
 * =========================================================
 * HOMEPAGE SECTION
 * =========================================================
 */

model HomepageSection {
  id String @id @default(cuid())

  type String

  title String

  subtitle String?

  eyebrow String?

  href String?

  categoryId String?

  category Category? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productLimit Int @default(8)

  active Boolean @default(true)

  sortOrder Int @default(0)

  @@map("homepagesection")
}

/**
 * =========================================================
 * SITE SETTINGS
 * =========================================================
 */

model SiteSettings {
  id String @id @default(cuid())

  siteName String @default("Prenaxo")

  logo String?

  contactEmail String?
  contactPhone String?

  currency String @default("BDT")

  shippingCharge Decimal @default(60) @db.Decimal(10, 2)

  freeDeliveryThreshold Decimal @default(2000) @db.Decimal(10, 2)

  /**
   * SEO
   */

  metaTitle String?

  metaDescription String?

  keywords Json?

  canonicalUrl String?

  ogTitle       String?
  ogDescription String?
  ogImage       String?

  /**
   * Marketing / Tracking
   */

  googleAnalyticsId String?

  googleSearchConsoleVerification String?

  facebookPixelId String?

  tikTokPixelId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sitesettings")
}

/**
 * =========================================================
 * DELIVERY ZONE
 * =========================================================
 */

model DeliveryZone {
  id String @id @default(cuid())

  division String

  district String @unique

  charge Decimal @db.Decimal(10, 2)

  estimatedDelivery String

  insideDhaka Boolean @default(false)

  active Boolean @default(true)
  settingsId        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@map("deliveryzone")
}

/**
 * =========================================================
 * ADMIN ACTIVITY
 * =========================================================
 */

model AdminActivity {
  id String @id @default(cuid())

  action String

  entity String

  entityId String?

  adminId String

  admin User @relation(fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metadata Json?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([entity])

  @@map("adminactivity")
}

/**
 * =========================================================
 * PRODUCT SEO
 * =========================================================
 */

model ProductSEO {
  id String @id @default(cuid())

  productId String @unique

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metaTitle String?

  metaDescription String?

  focusKeyword String?

  secondaryKeywords Json?

  canonicalUrl String?

  robotsIndex SEOIndexStatus @default(INDEX)

  robotsFollow SEORobotsFollow @default(FOLLOW)

  ogTitle       String?
  ogDescription String?
  ogImage       String?

  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?

  schemaType String? @default("Product")

  schemaJson Json?

  seoScore Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("productseo")
}

/**
 * =========================================================
 * CATEGORY SEO
 * =========================================================
 */

model CategorySEO {
  id String @id @default(cuid())

  categoryId String @unique

  category Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metaTitle String?

  metaDescription String?

  focusKeyword String?

  secondaryKeywords Json?

  canonicalUrl String?

  robotsIndex SEOIndexStatus @default(INDEX)

  robotsFollow SEORobotsFollow @default(FOLLOW)

  ogTitle       String?
  ogDescription String?
  ogImage       String?

  schemaType String?

  schemaJson Json?

  seoScore Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("categoryseo")
}

/**
 * =========================================================
 * BRAND SEO
 * =========================================================
 */

model BrandSEO {
  id String @id @default(cuid())

  brandId String @unique

  brand Brand @relation(fields: [brandId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metaTitle String?

  metaDescription String?

  focusKeyword String?

  secondaryKeywords Json?

  canonicalUrl String?

  robotsIndex SEOIndexStatus @default(INDEX)

  robotsFollow SEORobotsFollow @default(FOLLOW)

  ogTitle       String?
  ogDescription String?
  ogImage       String?

  schemaType String?

  schemaJson Json?

  seoScore Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("brandseo")
}

/**
 * =========================================================
 * PAGE
 * =========================================================
 */

model Page {
  id String @id @default(cuid())

  title String

  slug String @unique

  excerpt String?

  content String?

  featuredImage String?

  active Boolean @default(true)

  published Boolean @default(false)

  seo PageSEO?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("page")
}

/**
 * =========================================================
 * PAGE SEO
 * =========================================================
 */

model PageSEO {
  id String @id @default(cuid())

  pageId String @unique

  page Page @relation(fields: [pageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  metaTitle String?

  metaDescription String?

  focusKeyword String?

  secondaryKeywords Json?

  canonicalUrl String?

  robotsIndex SEOIndexStatus @default(INDEX)

  robotsFollow SEORobotsFollow @default(FOLLOW)

  ogTitle       String?
  ogDescription String?
  ogImage       String?

  twitterTitle       String?
  twitterDescription String?
  twitterImage       String?

  schemaType String?

  schemaJson Json?

  seoScore Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("pageseo")
}

/**
 * =========================================================
 * REDIRECT MANAGER
 * =========================================================
 */

model Redirect {
  id String @id @default(cuid())

  fromPath String @unique

  toPath String

  type RedirectType @default(PERMANENT)

  active Boolean @default(true)

  hitCount Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("redirect")
}

